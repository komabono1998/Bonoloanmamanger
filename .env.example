# Copy to .env (never commit .env). In production prefer your platform's secret manager over a file.
APP_ENV=production
APP_KEY=change-me-to-a-long-random-string        # encrypts MFA seeds at rest. Generate: openssl rand -base64 48
DOMAIN=loans.example.com

# Database (managed PostgreSQL recommended)
DB_DRIVER=pgsql
DB_HOST=db
DB_PORT=5432
DB_NAME=bono
DB_USER=bono_app
DB_PASSWORD=change-me
DB_SSLMODE=prefer                                # use "require" or "verify-full" for a managed database
# DB_SCHEMA=public

# Reverse proxy / load balancer in front of the app (so HTTPS and client IPs are detected correctly)
TRUST_PROXY=1

# Sessions shared across several app servers
SESSION_DRIVER=db

# Private file storage: local volume (default) or an S3-compatible bucket
STORAGE_DRIVER=local
STORAGE_PATH=/data/uploads
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_REGION=eu-west-1
# S3_BUCKET=bono-private-docs
# S3_KEY=
# S3_SECRET=

# Backups (pg_dump). Keep a copy on a separate volume/account.
BACKUP_DIR=/data/backups
# PG_BIN=/usr/bin

LOG_TO_STDERR=1

# Public address used in emailed links (origin only, no path). Optional SMTP can also be set here instead of in Settings > Email.
APP_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=tls
# SMTP_USER=
# SMTP_PASS=

# Organisations: let new organisations register themselves from the sign-in page (default: on locally, off in production).
SELF_REGISTRATION=
# PostgreSQL: the database user needs CREATEDB so each organisation gets its own database.

